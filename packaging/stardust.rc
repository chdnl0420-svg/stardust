// 실행 파일에 박아 넣는 리소스.
//
// 탐색기·작업표시줄이 보여 주는 아이콘은 실행 파일 안의 **첫 번째 ICON 리소스**다.
// 그래서 번호를 1 로 두고, 창 아이콘도 같은 번호를 불러 쓴다(main.cpp).
1 ICON "assets/stardust.ico"

// 파일 속성과 작업표시줄이 읽는 이름표.
// 이게 없으면 윈도우가 보여 줄 이름이 없어 창 제목 첫 글자만 덩그러니 뜬다.
#include <winver.h>

// **버전을 담은 자리가 셋이고, 셋이 같아야 한다.**
//   · `src/app/Version.h`   STARDUST_VERSION — 자동 업데이트가 견주는 기준
//   · `packaging/stardust.iss` AppVersion    — 설치 프로그램이 말하는 버전
//   · 여기                                    — 탐색기 파일 속성이 보여 주는 버전
// 앞의 둘만 챙기다 여기가 **0.6.1 에 멈춰 0.6.2~0.6.8 내내 어긋나 있었다**
// (2026-08-19 에 발견 — 설치본 파일 속성은 0.6.1, 레지스트리는 0.6.6 이었다).
// 설치는 `ignoreversion` 플래그 덕에 되고 있었으므로 아무도 안 걸렸다.
1 VERSIONINFO
FILEVERSION    0,7,2,0
PRODUCTVERSION 0,7,2,0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    // 040904B0 = 미국 영어 + 유니코드. 한국어 윈도우에서도 이 블록을 읽는다.
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "JustKim"
      VALUE "FileDescription",  "Stardust"
      VALUE "FileVersion",      "0.7.2"
      VALUE "InternalName",     "Stardust"
      VALUE "OriginalFilename", "Stardust.exe"
      VALUE "ProductName",      "Stardust"
      VALUE "ProductVersion",   "0.7.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
